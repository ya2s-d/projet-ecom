{%- comment -%}
  PLUSH — section Avant / Après « côte à côte », version « Liquid personnalisé ».
  Colle tout ce code dans un bloc « Liquid personnalisé » de la page produit.

  TES 2 VIDÉOS
  1. Contenu > Fichiers > Importer : importe tes 2 vidéos (.mp4).
  2. Clique sur chaque vidéo > copie le lien (il commence par https://cdn.shopify.com/).
  3. Colle-les entre les guillemets de video_before et video_after, juste en dessous.
  Tant qu'un lien est vide, la case montre un rappel au lieu de la vidéo.

  FORMAT DES VIDÉOS
  - ratio = la forme des 2 cases. '9 / 14' (vidéo filmée au téléphone, par défaut),
    '4 / 5' (un peu moins haute), '1 / 1' (carré).
  - Les vidéos tournent en boucle, sans le son, comme un GIF.

  SOUS LES VIDÉOS : 2 coches (check_1, check_2). Mets '' pour en cacher une.
  SOUS LE BOUTON : 2 garanties avec icône (perk_1, perk_2). Mets '' pour en cacher une.

  LE BOUTON remonte jusqu'au choix Duo / Solo. Le prix affiché vient tout seul de ta fiche
  produit : si tu changes un prix dans Shopify, il change ici aussi.
  Police : Poppins, uniquement dans ce bloc. Le reste du site n'est pas touché.
{%- endcomment -%}

{%- liquid
  assign video_before = ''
  assign video_after = ''
  assign ratio = '9 / 14'

  assign label_before = 'Before'
  assign caption_before = 'Your shower head'
  assign label_after = 'After'
  assign caption_after = 'Plush filtered'

  assign headline = 'Your shower head came with the place.'
  assign check_1 = 'Filters chlorine'
  assign check_2 = '2-min install, no tools'
  assign button = 'Get Plush'
  assign perk_1 = 'Free U.S. shipping'
  assign perk_2 = '60-day money back'
  assign show_price = true

  assign c_ink = '#141414'
  assign c_muted = '#6B6660'
  assign c_accent = '#8A4524'
  assign space_top = 16
  assign space_bottom = 32
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

<div
  class="plush-ba"
  style="--pba-ink:{{ c_ink }};--pba-muted:{{ c_muted }};--pba-accent:{{ c_accent }};--pba-ratio:{{ ratio }};margin:{{ space_top }}px 0 {{ space_bottom }}px;"
>
  <h2 class="pba-title">{{ headline | escape }}</h2>

  <div class="pba-media">
    {%- for i in (1..2) -%}
      {%- liquid
        if i == 1
          assign v_src = video_before
          assign v_label = label_before
          assign v_caption = caption_before
          assign v_mod = 'before'
          assign v_hint = 'video_before'
        else
          assign v_src = video_after
          assign v_label = label_after
          assign v_caption = caption_after
          assign v_mod = 'after'
          assign v_hint = 'video_after'
        endif
      -%}
      <figure class="pba-item pba-item--{{ v_mod }}">
        <div class="pba-card">
          {%- if v_src != blank -%}
            <video src="{{ v_src }}" autoplay muted loop playsinline preload="metadata" aria-label="{{ v_label | escape }} — {{ v_caption | escape }}"></video>
          {%- else -%}
            <div class="pba-empty">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M10 8.5v7l6-3.5z"/></svg>
              <span>Colle le lien dans <b>{{ v_hint }}</b></span>
            </div>
          {%- endif -%}
          <span class="pba-tag">{{ v_label | escape }}</span>
        </div>
        <figcaption class="pba-cap">{{ v_caption | escape }}</figcaption>
      </figure>
    {%- endfor -%}
  </div>

  {%- if check_1 != blank or check_2 != blank -%}
    <ul class="pba-checks" role="list">
      {%- if check_1 != blank -%}
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{ check_1 | escape }}</li>
      {%- endif -%}
      {%- if check_2 != blank -%}
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{ check_2 | escape }}</li>
      {%- endif -%}
    </ul>
  {%- endif -%}

  <div class="pba-copy">
    {%- if show_price and product -%}
      <p class="pba-price">
        {%- if product.price_varies -%}<span class="pba-from">From{{ ' ' }}</span>{%- endif -%}
        {{ product.price_min | money }}
      </p>
    {%- endif -%}
    <a href="#" class="pba-btn" data-plush-ba-cta>{{ button | escape }}</a>
    {%- if perk_1 != blank or perk_2 != blank -%}
      <ul class="pba-perks" role="list">
        {%- if perk_1 != blank -%}
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h11.5v10H2.5zM14 10h4.2l3.3 3.4v3.1H14"/><circle cx="6.5" cy="17.5" r="1.9"/><circle cx="17.5" cy="17.5" r="1.9"/></svg>{{ perk_1 | escape }}</li>
        {%- endif -%}
        {%- if perk_2 != blank -%}
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg>{{ perk_2 | escape }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<style>
  .plush-ba{container-type:inline-size;font-family:'Poppins',sans-serif;color:var(--pba-ink);text-align:center}
  .plush-ba *{box-sizing:border-box}
  .plush-ba .pba-title{margin:0 auto 18px;max-width:20ch;font-family:inherit;font-size:28px;font-size:clamp(24px,7.4cqi,38px);font-weight:600;line-height:1.15;letter-spacing:-.01em;color:var(--pba-ink);text-wrap:balance}
  .plush-ba .pba-media{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:640px;margin:0 auto}
  .plush-ba .pba-item{margin:0;min-width:0}
  .plush-ba .pba-card{position:relative;aspect-ratio:var(--pba-ratio);border-radius:16px;overflow:hidden;background:#141414}
  .plush-ba .pba-card video{width:100%;height:100%;object-fit:cover;display:block}
  .plush-ba .pba-empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:14px;color:rgba(255,255,255,.7);font-size:12px;line-height:1.4}
  .plush-ba .pba-empty svg{width:34px;height:34px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linejoin:round}
  .plush-ba .pba-empty b{color:#fff;font-weight:600;word-break:break-word}
  .plush-ba .pba-tag{position:absolute;left:8px;top:8px;padding:5px 10px;border-radius:999px;background:#fff;color:#141414;font-size:10px;font-weight:600;line-height:1;letter-spacing:.06em;text-transform:uppercase;box-shadow:0 1px 4px rgba(0,0,0,.18)}
  .plush-ba .pba-item--after .pba-tag{background:var(--pba-accent);color:#fff}
  .plush-ba .pba-cap{margin-top:8px;font-size:13px;line-height:1.3;color:var(--pba-muted)}
  .plush-ba .pba-copy{max-width:460px;margin:0 auto}
  .plush-ba ul.pba-checks,.plush-ba ul.pba-perks{list-style:none;padding:0;display:flex;flex-wrap:wrap;justify-content:center}
  .plush-ba ul.pba-checks{gap:6px 16px;margin:20px auto 0}
  .plush-ba .pba-checks li{display:inline-flex;align-items:center;gap:5px;margin:0;font-size:14px;font-weight:500;line-height:1.3;color:var(--pba-ink)}
  .plush-ba .pba-checks svg{flex:none;width:16px;height:16px;fill:none;stroke:var(--pba-accent);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
  .plush-ba ul.pba-perks{gap:6px 18px;margin:12px 0 0}
  .plush-ba .pba-perks li{display:inline-flex;align-items:center;gap:6px;margin:0;font-size:13px;font-weight:500;line-height:1.3;color:var(--pba-muted)}
  .plush-ba .pba-perks svg{flex:none;width:16px;height:16px;fill:none;stroke:var(--pba-accent);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .plush-ba .pba-price{margin:16px 0 14px;font-size:22px;font-weight:600;color:var(--pba-ink)}
  .plush-ba .pba-from{font-size:15px;font-weight:500;color:var(--pba-muted)}
  .plush-ba .pba-btn{display:block;width:100%;padding:17px 20px;border-radius:12px;background:var(--pba-accent);color:#fff;font-size:16px;font-weight:600;letter-spacing:.01em;text-decoration:none;transition:filter .15s}
  .plush-ba .pba-btn:hover{filter:brightness(1.08)}

  @container (min-width:640px){
    .plush-ba .pba-media{gap:14px}
    .plush-ba .pba-tag{left:12px;top:12px;font-size:11px}
    .plush-ba .pba-cap{font-size:14px}
    .plush-ba .pba-checks li{font-size:15px}
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-plush-ba-cta]').forEach(function (btn) {
      if (btn.dataset.ready) return;
      btn.dataset.ready = '1';
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var target = document.querySelector('div.pb[data-selected]') || document.querySelector('form[action*="/cart/add"]');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });
  })();
</script>
