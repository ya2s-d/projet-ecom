{%- comment -%}
  PLUSH — Header, partie 1/2 : bandeau défilant + style du header (maquette C « Marque »).

  OÙ LE METTRE : Personnaliser > colonne de gauche, zone « En-tête » > Ajouter une section
  > « Liquid personnalisé » > colle tout ce code.
  Glisse cette section AU-DESSUS de « En-tête ». Marge supérieure 0, marge inférieure 0.
  Cache l'ancien « Countdown Timer » avec l'icône de l'œil.
  La partie 2 (plush-header-garanties.liquid) va JUSTE EN DESSOUS de « En-tête ».

  ⚠️ Ne supprime jamais cette section, même sans promo : c'est elle qui donne au header sa
  couleur marron, son logo clair et le style du menu. Quand la promo est finie, seul le
  bandeau se cache (dans l'éditeur il reste visible, pour que tu puisses le régler).

  LA PROMO, les 2 seules lignes à changer :
  - sale_end : dernier jour de la promo, format aaaa-mm-jj. Fin à 23:59, heure de New York.
  - sale_items : les messages qui défilent, séparés par |. [countdown] = le compte à rebours.
{%- endcomment -%}

{%- liquid
  assign sale_end = '2026-11-13'
  assign sale_items = '🍂 Fall Sale|Ends in [countdown]'

  assign end_at = sale_end | append: 'T23:59:59-05:00'
  assign end_ts = end_at | date: '%s' | plus: 0
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign left = end_ts | minus: now_ts
  if left < 0
    assign left = 0
  endif
  assign cd_d = left | divided_by: 86400
  assign cd_h = left | modulo: 86400 | divided_by: 3600 | prepend: '0' | slice: -2, 2
  assign cd_m = left | modulo: 3600 | divided_by: 60 | prepend: '0' | slice: -2, 2
  assign cd_s = left | modulo: 60 | prepend: '0' | slice: -2, 2
  assign cd_html = '<b class="pl-cd">' | append: cd_d | append: 'd ' | append: cd_h | append: 'h ' | append: cd_m | append: 'm ' | append: cd_s | append: 's</b>'
  assign items = sale_items | split: '|'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  /* ---------- Bandeau défilant ---------- */
  .pl-tk{display:flex;align-items:center;height:30px;overflow:hidden;background:#F7F2EA;color:#8A4524;border-bottom:1px solid #E2D6C5;font:600 10.5px/1 'Poppins',sans-serif;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
  .pl-tk__track{display:flex;flex:none;animation:pl-tk 60s linear infinite}
  .pl-tk__seq{display:flex;flex:none;align-items:center}
  .pl-tk__seq span{padding:0 14px}
  .pl-tk__seq i{font:inherit;opacity:.5}
  .pl-cd{font-weight:600;font-variant-numeric:tabular-nums}
  @keyframes pl-tk{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.pl-tk__track{animation:none}}
  @media (min-width:750px){.pl-tk{height:36px;font-size:12px}}

  /* ---------- Header marron, logo clair ---------- */
  sticky-header.header-wrapper{--color-background:138,69,36;--gradient-background:#8A4524;--color-foreground:247,242,234;background:#8A4524;border-bottom:0}
  sticky-header.header-wrapper .header{padding-top:8px;padding-bottom:8px}
  sticky-header.header-wrapper .header__heading-link{padding:0}
  sticky-header.header-wrapper .header__heading-logo{width:100px;height:auto;filter:brightness(0) invert(1);opacity:.95}
  sticky-header.header-wrapper .header__icon{color:#F7F2EA}
  sticky-header.header-wrapper .header__search,
  sticky-header.header-wrapper .header__icon--account{display:none!important}
  sticky-header.header-wrapper .header__menu-item{padding:12px 18px;color:rgba(247,242,234,.88);font:500 15px/1 'Poppins',sans-serif;letter-spacing:.01em}
  sticky-header.header-wrapper .header__menu-item:hover{color:#F7F2EA}
  sticky-header.header-wrapper li:has(> a[href="/"]){display:none}
  sticky-header.header-wrapper .cart-count-bubble{background:#F7F2EA;color:#8A4524}
  .pl-cta{display:none}
  @media (min-width:990px){
    sticky-header.header-wrapper .header{padding-top:14px;padding-bottom:14px}
    sticky-header.header-wrapper .header__heading-logo{width:126px}
    .pl-cta{display:inline-flex;align-items:center;height:42px;margin-right:10px;padding:0 22px;border-radius:99px;background:#F7F2EA;color:#8A4524;font:600 14px/1 'Poppins',sans-serif;text-decoration:none;white-space:nowrap;transition:background .2s}
    .pl-cta:hover{background:#fff}
  }

  /* ---------- Ligne de garanties (partie 2) ---------- */
  .pl-ts{display:flex;align-items:center;justify-content:center;gap:8px;height:34px;padding:0 10px;overflow:hidden;background:#F7F2EA;border-bottom:1px solid #E2D6C5;color:#1F1D24;font:500 11px/1 'Poppins',sans-serif;white-space:nowrap}
  .pl-ts .pl-ti{display:flex;align-items:center;gap:5px}
  .pl-ts svg{flex:none;width:15px;height:15px;color:#8A4524}
  .pl-ts i{flex:none;width:3px;height:3px;border-radius:50%;background:#C4B59F}
  .pl-ts .pl-d{display:none}
  @media (max-width:389px){.pl-ts{gap:7px;font-size:10.5px}.pl-ts svg{display:none}}
  @media (min-width:750px){
    .pl-ts{gap:16px;height:40px;font-size:13px}
    .pl-ts svg{width:17px;height:17px}
  }
  @media (min-width:990px){
    .pl-ts{gap:22px;height:44px;font-size:14px}
    .pl-ts svg{width:19px;height:19px}
    .pl-ts .pl-m{display:none}
    .pl-ts .pl-d{display:inline}
  }

  /* ---------- Menu tel : plein écran marron ---------- */
  #menu-drawer{--color-background:138,69,36;--gradient-background:#8A4524;--color-foreground:247,242,234;background:#8A4524;color:#F7F2EA}
  #menu-drawer .menu-drawer__navigation-container{display:flex;flex-direction:column}
  #menu-drawer .menu-drawer__navigation{padding:4px 0 0}
  #menu-drawer .menu-drawer__menu-item{display:flex;align-items:center;margin:0 24px;padding:15px 0;border-bottom:1px solid rgba(247,242,234,.2);background:none;color:#F7F2EA;font:600 30px/1.1 'Poppins',sans-serif;letter-spacing:-.02em;text-decoration:none}
  #menu-drawer .menu-drawer__menu-item::after{content:'';flex:none;width:9px;height:9px;margin:0 4px 0 auto;border:solid currentColor;border-width:0 2px 2px 0;transform:rotate(-45deg);opacity:.6}
  #menu-drawer li:has(> a[href="/"]),
  #menu-drawer .menu-drawer__utility-links{display:none}
  .pl-badge{flex:none;margin-left:12px;padding:4px 9px;border-radius:99px;background:#F7F2EA;color:#8A4524;font:600 10px/1 'Poppins',sans-serif;letter-spacing:.09em;text-transform:uppercase}
  .pl-dr{display:flex;flex:1;flex-direction:column;padding:22px 24px 26px;color:#F7F2EA;font-family:'Poppins',sans-serif}
  .pl-card{display:grid;grid-template-columns:88px 1fr;gap:12px 14px;align-items:center;padding:12px;border-radius:20px;background:#F7F2EA;color:#1F1D24;text-decoration:none}
  .pl-card__im{display:grid;place-items:center;width:88px;height:88px;border-radius:14px;background:#EFE7DA}
  .pl-card__im img{width:76px;height:auto}
  .pl-card__t{display:block;font:600 14.5px/1.3 'Poppins',sans-serif}
  .pl-card__s{display:block;margin-top:1px;color:#6B6660;font:400 12.5px/1.4 'Poppins',sans-serif}
  .pl-card__p{display:block;margin-top:7px;color:#8A4524;font:600 15.5px/1 'Poppins',sans-serif}
  .pl-card__p s{margin-left:7px;color:#8F887F;font-size:12.5px;font-weight:400}
  .pl-card__b{display:flex;grid-column:1/-1;align-items:center;justify-content:center;gap:8px;height:46px;border-radius:99px;background:#8A4524;color:#fff;font:600 15px/1 'Poppins',sans-serif}
  .pl-card__b svg{width:18px;height:18px}
  .pl-tr{display:grid;gap:10px;margin:20px 0 0;padding:0;list-style:none}
  .pl-tr li{display:flex;align-items:center;gap:11px;font:500 13.5px/1.3 'Poppins',sans-serif}
  .pl-tr svg{flex:none;width:20px;height:20px}
  .pl-dr__line{margin:auto 0 0;padding-top:28px;font:500 13.5px/1.5 'Poppins',sans-serif;opacity:.8}
  .pl-dr__acc{display:flex;align-items:center;gap:8px;margin-top:12px;color:#F7F2EA;font:500 13px/1 'Poppins',sans-serif;text-decoration:none;opacity:.9}
  .pl-dr__acc svg{width:18px;height:18px}
</style>

{%- if left > 0 or request.design_mode -%}
  <div id="pl-tk" class="pl-tk" data-end="{{ end_at }}">
    <div class="pl-tk__track">
      {%- for r in (1..2) -%}
        <div class="pl-tk__seq"{% if r == 2 %} aria-hidden="true"{% endif %}>
          {%- for k in (1..8) -%}
            {%- for it in items -%}
              <span{% if k > 1 %} aria-hidden="true"{% endif %}>{{ it | replace: '[countdown]', cd_html }}</span><i aria-hidden="true">✦</i>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function () {
      var box = document.getElementById('pl-tk');
      if (!box) return;
      var end = new Date(box.getAttribute('data-end')).getTime();
      var editor = {{ request.design_mode | json }};
      var cds = box.querySelectorAll('.pl-cd');
      function p(n) { return n < 10 ? '0' + n : '' + n; }
      function tick() {
        var t = end - Date.now();
        if (t <= 0) {
          t = 0;
          if (!editor) box.style.display = 'none';
        }
        var txt = Math.floor(t / 864e5) + 'd ' + p(Math.floor(t % 864e5 / 36e5)) + 'h '
          + p(Math.floor(t % 36e5 / 6e4)) + 'm ' + p(Math.floor(t % 6e4 / 1e3)) + 's';
        for (var i = 0; i < cds.length; i++) cds[i].textContent = txt;
        if (t > 0) setTimeout(tick, 1000);
      }
      tick();
    })();
  </script>
{%- endif -%}
