        "custom_liquid": "{%- comment -%}\n  PLUSH — Header, partie 1/2 : bandeau défilant + style du header (maquette C « Marque »).\n\n  OÙ LE METTRE : Personnaliser > colonne de gauche, zone « En-tête » > Ajouter une section\n  > « Liquid personnalisé » > colle tout ce code.\n  Glisse cette section AU-DESSUS de « En-tête ». Marge supérieure 0, marge inférieure 0.\n  Cache l'ancien « Countdown Timer » avec l'icône de l'œil.\n  La partie 2 (plush-header-garanties.liquid) va JUSTE EN DESSOUS de « En-tête ».\n\n  ⚠️ Ne supprime jamais cette section, même sans promo : c'est elle qui donne au header sa\n  couleur marron, son logo clair et le style du menu. Quand la promo est finie, seul le\n  bandeau se cache (dans l'éditeur il reste visible, pour que tu puisses le régler).\n\n  LA PROMO, les 2 seules lignes à changer :\n  - sale_end : dernier jour de la promo, format aaaa-mm-jj. Fin à 23:59, heure de New York.\n  - sale_items : les messages qui défilent, séparés par |. [countdown] = le compte à rebours.\n{%- endcomment -%}\n\n{%- liquid\n  assign sale_end = '2026-11-13'\n  assign sale_items = '🍂 Fall Sale|Ends in [countdown]'\n\n  assign end_at = sale_end | append: 'T23:59:59-05:00'\n  assign end_ts = end_at | date: '%s' | plus: 0\n  assign now_ts = 'now' | date: '%s' | plus: 0\n  assign left = end_ts | minus: now_ts\n  if left < 0\n    assign left = 0\n  endif\n  assign cd_d = left | divided_by: 86400\n  assign cd_h = left | modulo: 86400 | divided_by: 3600 | prepend: '0' | slice: -2, 2\n  assign cd_m = left | modulo: 3600 | divided_by: 60 | prepend: '0' | slice: -2, 2\n  assign cd_s = left | modulo: 60 | prepend: '0' | slice: -2, 2\n  assign cd_html = '<b class=\"pl-cd\">' | append: cd_d | append: 'd ' | append: cd_h | append: 'h ' | append: cd_m | append: 'm ' | append: cd_s | append: 's</b>'\n  assign items = sale_items | split: '|'\n-%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  /* ---------- Bandeau défilant ---------- */\n  .pl-tk{display:flex;align-items:center;height:30px;overflow:hidden;background:#F7F2EA;color:#8A4524;border-bottom:1px solid #E2D6C5;font:600 10.5px/1 'Poppins',sans-serif;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}\n  .pl-tk__track{display:flex;flex:none;animation:pl-tk 60s linear infinite}\n  .pl-tk__seq{display:flex;flex:none;align-items:center}\n  .pl-tk__seq span{padding:0 14px}\n  .pl-tk__seq i{font:inherit;opacity:.5}\n  .pl-cd{font-weight:600;font-variant-numeric:tabular-nums}\n  @keyframes pl-tk{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n  @media (prefers-reduced-motion:reduce){.pl-tk__track{animation:none}}\n  @media (min-width:750px){.pl-tk{height:36px;font-size:12px}}\n\n  /* ---------- Header marron, logo clair ---------- */\n  sticky-header.header-wrapper{--color-background:138,69,36;--gradient-background:#8A4524;--color-foreground:247,242,234;background:#8A4524;border-bottom:0}\n  sticky-header.header-wrapper .header{padding-top:8px;padding-bottom:8px}\n  sticky-header.header-wrapper .header__heading-link{padding:0}\n  sticky-header.header-wrapper .header__heading-logo{width:100px;height:auto;filter:brightness(0) invert(1);opacity:.95}\n  sticky-header.header-wrapper .header__icon{color:#F7F2EA}\n  sticky-header.header-wrapper .header__search,\n  sticky-header.header-wrapper .header__icon--account{display:none!important}\n  sticky-header.header-wrapper .header__menu-item{padding:12px 18px;color:rgba(247,242,234,.88);font:500 15px/1 'Poppins',sans-serif;letter-spacing:.01em}\n  sticky-header.header-wrapper .header__menu-item:hover{color:#F7F2EA}\n  sticky-header.header-wrapper li:has(> a[href=\"/\"]){display:none}\n  sticky-header.header-wrapper .cart-count-bubble{background:#F7F2EA;color:#8A4524}\n  .pl-cta{display:none}\n  @media (min-width:990px){\n    sticky-header.header-wrapper .header{padding-top:14px;padding-bottom:14px}\n    sticky-header.header-wrapper .header__heading-logo{width:126px}\n    .pl-cta{display:inline-flex;align-items:center;height:42px;margin-right:10px;padding:0 22px;border-radius:99px;background:#F7F2EA;color:#8A4524;font:600 14px/1 'Poppins',sans-serif;text-decoration:none;white-space:nowrap;transition:background .2s}\n    .pl-cta:hover{background:#fff}\n  }\n\n  /* ---------- Ligne de garanties (partie 2) ---------- */\n  .pl-ts{display:flex;align-items:center;justify-content:center;gap:8px;height:34px;padding:0 10px;overflow:hidden;background:#F7F2EA;border-bottom:1px solid #E2D6C5;color:#1F1D24;font:500 11px/1 'Poppins',sans-serif;white-space:nowrap}\n  .pl-ts .pl-ti{display:flex;align-items:center;gap:5px}\n  .pl-ts svg{flex:none;width:15px;height:15px;color:#8A4524}\n  .pl-ts i{flex:none;width:3px;height:3px;border-radius:50%;background:#C4B59F}\n  .pl-ts .pl-d{display:none}\n  @media (max-width:389px){.pl-ts{gap:7px;font-size:10.5px}.pl-ts svg{display:none}}\n  @media (min-width:750px){\n    .pl-ts{gap:16px;height:40px;font-size:13px}\n    .pl-ts svg{width:17px;height:17px}\n  }\n  @media (min-width:990px){\n    .pl-ts{gap:22px;height:44px;font-size:14px}\n    .pl-ts svg{width:19px;height:19px}\n    .pl-ts .pl-m{display:none}\n    .pl-ts .pl-d{display:inline}\n  }\n\n  /* ---------- Menu tel : plein écran marron ---------- */\n  #menu-drawer{--color-background:138,69,36;--gradient-background:#8A4524;--color-foreground:247,242,234;background:#8A4524;color:#F7F2EA}\n  #menu-drawer .menu-drawer__navigation-container{display:flex;flex-direction:column}\n  #menu-drawer .menu-drawer__navigation{padding:4px 0 0}\n  #menu-drawer .menu-drawer__menu-item{display:flex;align-items:center;margin:0 24px;padding:15px 0;border-bottom:1px solid rgba(247,242,234,.2);background:none;color:#F7F2EA;font:600 30px/1.1 'Poppins',sans-serif;letter-spacing:-.02em;text-decoration:none}\n  #menu-drawer .menu-drawer__menu-item::after{content:'';flex:none;width:9px;height:9px;margin:0 4px 0 auto;border:solid currentColor;border-width:0 2px 2px 0;transform:rotate(-45deg);opacity:.6}\n  #menu-drawer li:has(> a[href=\"/\"]),\n  #menu-drawer .menu-drawer__utility-links{display:none}\n  .pl-badge{flex:none;margin-left:12px;padding:4px 9px;border-radius:99px;background:#F7F2EA;color:#8A4524;font:600 10px/1 'Poppins',sans-serif;letter-spacing:.09em;text-transform:uppercase}\n  .pl-dr{display:flex;flex:1;flex-direction:column;padding:22px 24px 26px;color:#F7F2EA;font-family:'Poppins',sans-serif}\n  .pl-card{display:grid;grid-template-columns:88px 1fr;gap:12px 14px;align-items:center;padding:12px;border-radius:20px;background:#F7F2EA;color:#1F1D24;text-decoration:none}\n  .pl-card__im{display:grid;place-items:center;width:88px;height:88px;border-radius:14px;background:#EFE7DA}\n  .pl-card__im img{width:76px;height:auto}\n  .pl-card__t{display:block;font:600 14.5px/1.3 'Poppins',sans-serif}\n  .pl-card__s{display:block;margin-top:1px;color:#6B6660;font:400 12.5px/1.4 'Poppins',sans-serif}\n  .pl-card__p{display:block;margin-top:7px;color:#8A4524;font:600 15.5px/1 'Poppins',sans-serif}\n  .pl-card__p s{margin-left:7px;color:#8F887F;font-size:12.5px;font-weight:400}\n  .pl-card__b{display:flex;grid-column:1/-1;align-items:center;justify-content:center;gap:8px;height:46px;border-radius:99px;background:#8A4524;color:#fff;font:600 15px/1 'Poppins',sans-serif}\n  .pl-card__b svg{width:18px;height:18px}\n  .pl-tr{display:grid;gap:10px;margin:20px 0 0;padding:0;list-style:none}\n  .pl-tr li{display:flex;align-items:center;gap:11px;font:500 13.5px/1.3 'Poppins',sans-serif}\n  .pl-tr svg{flex:none;width:20px;height:20px}\n  .pl-dr__line{margin:auto 0 0;padding-top:28px;font:500 13.5px/1.5 'Poppins',sans-serif;opacity:.8}\n  .pl-dr__acc{display:flex;align-items:center;gap:8px;margin-top:12px;color:#F7F2EA;font:500 13px/1 'Poppins',sans-serif;text-decoration:none;opacity:.9}\n  .pl-dr__acc svg{width:18px;height:18px}\n</style>\n\n{%- if left > 0 or request.design_mode -%}\n  <div id=\"pl-tk\" class=\"pl-tk\" data-end=\"{{ end_at }}\">\n    <div class=\"pl-tk__track\">\n      {%- for r in (1..2) -%}\n        <div class=\"pl-tk__seq\"{% if r == 2 %} aria-hidden=\"true\"{% endif %}>\n          {%- for k in (1..8) -%}\n            {%- for it in items -%}\n              <span{% if k > 1 %} aria-hidden=\"true\"{% endif %}>{{ it | replace: '[countdown]', cd_html }}</span><i aria-hidden=\"true\">✦</i>\n            {%- endfor -%}\n          {%- endfor -%}\n        </div>\n      {%- endfor -%}\n    </div>\n  </div>\n\n  <script>\n    (function () {\n      var box = document.getElementById('pl-tk');\n      if (!box) return;\n      var end = new Date(box.getAttribute('data-end')).getTime();\n      var editor = {{ request.design_mode | json }};\n      var cds = box.querySelectorAll('.pl-cd');\n      function p(n) { return n < 10 ? '0' + n : '' + n; }\n      function tick() {\n        var t = end - Date.now();\n        if (t <= 0) {\n          t = 0;\n          if (!editor) box.style.display = 'none';\n        }\n        var txt = Math.floor(t / 864e5) + 'd ' + p(Math.floor(t % 864e5 / 36e5)) + 'h '\n          + p(Math.floor(t % 36e5 / 6e4)) + 'm ' + p(Math.floor(t % 6e4 / 1e3)) + 's';\n        for (var i = 0; i < cds.length; i++) cds[i].textContent = txt;\n        if (t > 0) setTimeout(tick, 1000);\n      }\n      tick();\n    })();\n  </script>\n{%- endif -%}",
