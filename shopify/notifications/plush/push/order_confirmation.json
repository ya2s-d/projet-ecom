{"id": "gid://shopify/EmailTemplate/129930297683", "t": [{"locale": "en", "key": "title", "value": "Your Plush order {{name}} is confirmed", "translatableContentDigest": "57845872774fd64a1045c6d5b94e9de54c268ee0dc846a0fd385092d206d176d"}, {"locale": "en", "key": "body_html", "value": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light only\"><meta name=\"supported-color-schemes\" content=\"light\"><title>Your Plush order is confirmed</title><link href=\"https://fonts.googleapis.com/css2?family=League+Spartan:wght@700&family=Poppins:wght@400;500;600&display=swap\" rel=\"stylesheet\"><style>:root{color-scheme:light only}body{margin:0;padding:0;background:#E9E1D6;-webkit-text-size-adjust:100%}img{border:0;line-height:100%;outline:none;text-decoration:none}a{color:#141414}@media (max-width:620px){.pl-wrap{width:100%!important}.pl-h1{font-size:31px!important}.pl-pad{padding-left:22px!important;padding-right:22px!important}.pl-card{padding-left:14px!important;padding-right:14px!important}}</style></head><body style=\"margin:0;padding:0;background:#E9E1D6;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#E9E1D6;\"><tr><td align=\"center\" style=\"padding:24px 0;\"><table role=\"presentation\" class=\"pl-wrap\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:600px;max-width:600px;background:#F6F2ED;border-radius:4px;\"><tr><td align=\"center\" style=\"padding:30px 0 22px;\"><a href=\"{{ shop.url }}\" style=\"text-decoration:none;\"><img src=\"https://cdn.shopify.com/s/files/1/1112/3618/6451/files/plush-email-logo.png?v=1795092462\" width=\"104\" alt=\"plush\" style=\"display:block;width:104px;height:auto;\"></a></td></tr><tr><td align=\"center\" style=\"background:#8A4524;padding:13px 20px;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:12px;lin