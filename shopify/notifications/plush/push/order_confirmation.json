x;font-weight:600;color:#141414;white-space:nowrap;\">{{ pl_price }}</td></tr></table>{%- endfor -%}{%- assign pl_order_disc = 0 -%}{%- for d in discount_applications -%}{%- if d.target_selection == 'all' and d.target_type == 'line_item' -%}{%- assign pl_order_disc = pl_order_disc | plus: d.total_allocated_amount -%}{%- endif -%}{%- endfor -%}<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-top:1px solid #EFE9E1;margin-top:2px;\"><tr><td style=\"padding-top:10px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">Subtotal</td><td align=\"right\" style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">{{ subtotal_price | plus: pl_order_disc | money }}</td></tr>{%- for d in discount_applications -%}{%- if d.target_selection == 'all' and d.target_type != 'shipping_line' -%}<tr><td style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">Discount <span style=\"color:#A86B45;\">{{ d.title }}</span></td><td align=\"right\" style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">&minus;{{ d.total_allocated_amount | money }}</td></tr>{%- endif -%}{%- endfor -%}<tr><td style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">Shipping</td><td align=\"right\" style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">{%- if shipping_price == 0 -%}Free{%- else -%}{{ shipping_price | money }}{%- endif -%}</td></tr>{%- if tax_price > 0 -%}<tr><td style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">Taxes</td><td align=\"right\" style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#3F3B37;\">{{ tax_price | money }}</td></tr>{%- endif -%}<tr><td colspan=\"2\" style=\"padding:6px 0 0;border-top:1px solid #EFE9E1;font-size:0;line-height:0;\">&nbsp;</td></tr><tr><td style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#141414;\">Total</td><td align=\"right\" style=\"padding:5px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#141414;\">{{ total_price | money_with_currency }}</td></tr>{%- if total_discounts > 0 -%}<tr><td colspan=\"2\" align=\"right\" style=\"padding:2px 0 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:13px;font-weight:600;color:#A86B45;\">You saved {{ total_discounts | money }}</td></tr>{%- endif -%}</table></td></tr></table></td></tr></table></td></tr><tr><td class=\"pl-pad\" style=\"padding:34px 44px 0;\"><div style=\"font-family:'League Spartan','Poppins',Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;color:#141414;padding-bottom:6px;\">What happens next</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td width=\"40\" valign=\"top\" style=\"padding:8px 0;\"><div style=\"width:30px;height:30px;line-height:30px;border-radius:99px;background:#A86B45;color:#fff;text-align:center;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;\">1</div></td><td style=\"padding:12px 0 8px 8px;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#3F3B37;\"><b style=\"color:#141414;font-weight:600;\">We pack your order.</b> It leaves our warehouse with a tracking number.</td></tr><tr><td width=\"40\" valign=\"top\" style=\"padding:8px 0;\"><div style=\"width:30px;height:30px;line-height:30px;border-radius:99px;background:#A86B45;color:#fff;text-align:center;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;\">2</div></td><td style=\"padding:12px 0 8px 8px;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#3F3B37;\"><b style=\"color:#141414;font-weight:600;\">It ships to you.</b> Delivery takes 7 to 12 business days.</td></tr><tr><td width=\"40\" valign=\"top\" style=\"padding:8px 0;\"><div style=\"width:30px;height:30px;line-height:30px;border-radius:99px;background:#A86B45;color:#fff;text-align:center;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;\">3</div></td><td style=\"padding:12px 0 8px 8px;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#3F3B37;\"><b style=\"color:#141414;font-weight:600;\">You install it in 3 steps.</b> No tools, no plumber, about 2 minutes. The guide is in the box.</td></tr></table></td></tr>{%- assign pl_duo = false -%}{%- for line in subtotal_line_items -%}{%- if line.variant.title contains 'Spare' -%}{%- assign pl_duo = true -%}{%- endif -%}{%- endfor -%}{%- if pl_duo -%}<tr><td style=\"padding:34px 28px 0;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ECE2D4;border-radius:20px;\"><tr><td width=\"130\" style=\"padding:18px 0 18px 18px;\"><img src=\"https://cdn.shopify.com/s/files/1/1112/3618/6451/files/plush-email-ebook.jpg?v=1795092727\" width=\"112\" alt=\"\" style=\"display:block;width:112px;height:auto;border-radius:14px;\"></td><td style=\"padding:18px 22px 18px 18px;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.55;color:#3F3B37;\"><div style=\"font-family:'League Spartan','Poppins',Helvetica,Arial,sans-serif;font-size:21px;line-height:1.15;font-weight:700;color:#141414;padding-bottom:6px;\">Your free eBook</div>Know Your Water arrives in a separate email. It shows you how to read your city's water report.</td></tr></table></td></tr>{%- endif -%}{%- if requires_shipping and shipping_address -%}<tr><td class=\"pl-pad\" style=\"padding:26px 44px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#3F3B37;\"><b style=\"display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#6B6660;padding-bottom:4px;\">Shipping to</b>{{ shipping_address | format_address }}</td></tr>{%- endif -%}<tr><td align=\"center\" class=\"pl-pad\" style=\"padding:40px 44px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#3F3B37;\">Questions? Just reply to this email.<br>A real person answers, usually within a day.</td></tr><tr><td align=\"center\" style=\"padding:30px 24px 34px;\"><img src=\"https://cdn.shopify.com/s/files/1/1112/3618/6451/files/plush-email-logo.png?v=1795092462\" width=\"64\" alt=\"plush\" style=\"display:block;width:64px;height:auto;margin:0 auto 10px;opacity:.85;\"><div style=\"font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.7;color:#6B6660;\">Same shower. Better water.<br><a href=\"{{ shop.url }}\" style=\"color:#6B6660;\">myplush.us</a> &middot; <a href=\"mailto:{{ shop.email }}\" style=\"color:#6B6660;\">{{ shop.email }}</a></div></td></tr></table></td></tr></table></body></html>", "translatableContentDigest": "d9dd0d4fac8e5d6be902df037222b96ef051437ec641526627b97c8699ba333c"}]}