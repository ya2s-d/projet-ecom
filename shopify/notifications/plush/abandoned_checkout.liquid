<td align="right" style="padding:14px 0;vertical-align:middle;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;color:#141414;white-space:nowrap;">{{ pl_price }}</td></tr></table>{%- endfor -%}
</td></tr></table></td></tr><tr><td style="padding:30px 28px 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #E2D9CC;border-bottom:1px solid #E2D9CC;"><tr>
