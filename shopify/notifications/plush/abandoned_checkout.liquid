<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" bgcolor="#141414" style="border-radius:99px;">
<a href="{{ url }}" style="display:inline-block;padding:16px 36px;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#F6F2ED;text-decoration:none;border-radius:99px;">Complete your order</a>
</td></tr></table></td></tr><tr><td align="center" class="pl-pad" style="padding:40px 44px 0;font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#3F3B37;">Questions? Just reply to this email.<br>A real person answers, usually within a day.</td></tr>
<tr><td align="center" style="padding:30px 24px 34px;"><img src="https://cdn.shopify.com/s/files/1/1112/3618/6451/files/plush-email-logo.png?v=1795092462" width="64" alt="plush" style="display:block;width:64px;height:auto;margin:0 auto 10px;opacity:.85;">
<div style="font-family:'Poppins',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.7;color:#6B6660;">Same shower. Better water.<br><a href="{{ shop.url }}" style="color:#6B6660;">myplush.us</a> &middot; <a href="mailto:{{ shop.email }}" style="color:#6B6660;">{{ shop.email }}</a><br><a href="{{ unsubscribe_url }}" style="color:#6B6660;">Unsubscribe</a></div></td></tr>
</table>
</td></tr></table>
