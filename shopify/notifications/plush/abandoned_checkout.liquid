{%- for line in subtotal_line_items -%}{%- if line.product.title -%}{%- assign pl_t = line.product.title -%}{%- else -%}{%- assign pl_t = line.title -%}{%- endif -%}{%- capture pl_img -%}{%- if line.image -%}<img src="{{ line | img_url: 'compact_cropped' }}" width="64" height="64" alt="" style="display:block;width:64px;height:64px;border-radius:12px;background:#F3EEE7;object-fit:cover;">{%- else -%}<img src="https://cdn.shopify.com/s/files/1/1112/3618/6451/files/plush-email-protection.png?v=1795092727" width="64" height="64" alt="" style="display:block;width:64px;height:64px;border-radius:12px;">{%- endif -%}{%- endcapture -%}{%- capture pl_sub -%}{%- if line.variant.title != 'Default Title' and line.variant.title != blank -%}<br><span style="color:#6B6660;font-size:13px;">{{ line.variant.title }}</span>{%- endif -%}{%- endcapture -%}{%- capture pl_price -%}{%- if line.original_line_price != line.final_line_price -%}<s style="color:#6B6660;font-weight:400;font-size:12px;">{{ line.original_line_price | money }}</s><br>{%- endif -%}{{ line.final_line_price | money }}{%- endcapture -%}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #EFE9E1;"><tr>
