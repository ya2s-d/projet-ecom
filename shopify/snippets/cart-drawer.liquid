{%- capture pc_cart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.6"/><path d="M7 6.5h10M7 17.5h10M10.2 9.3v5.4M13.8 9.3v5.4"/></svg>{%- endcapture -%}
