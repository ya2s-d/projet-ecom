{%- capture pc_gift -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C9.5 3 11 5 12 8c1-3 2.5-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>{%- endcapture -%}
{%- capture pc_trash -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>{%- endcapture -%}
{%- capture pc_lock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="10" x="4" y="11" rx="2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/></svg>{%- endcapture -%}
{%- capture pc_minus -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>{%- endcapture -%}
{%- capture pc_plus -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>{%- endcapture -%}
{%- capture pc_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"/></svg>{%- endcapture -%}

{%- if settings.enable_cart_upsell -%}
  {%- assign upsell_product = all_products[settings.cart_upsell_product_2] -%}
  {%- if upsell_product -%}{%- assign variant_id = upsell_product.variants.first.id -%}{%- endif -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer" data-cart-upsell-variant-id="{{ variant_id }}"></script>
{%- else -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<cart-drawer
  id="drawerMode"
  class="drawer{% if cart == empty %} is-empty{% endif %}{% if request.design_mode and settings.edit_mode %} active{% endif %}"
  style="--pc-brown:{{ c_brown }};--pc-paper:{{ c_paper }};--pc-cream:{{ c_cream }};--pc-ink:{{ c_ink }};"
>
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div class="drawer__inner pc-drawer" role="dialog" aria-modal="true" aria-label="Your cart" tabindex="-1">
      {%- if cart == empty -%}
        <div class="drawer__inner-empty pc-empty">
          <button class="pc-close pc-close--dark" type="button" onclick="this.closest('cart-drawer').close()" aria-label="Close">{{ pc_x }}</button>
          <span class="pc-empty__icon">{{ pc_bag }}</span>
          <p class="pc-empty__title">Your cart is empty</p>
          <p class="pc-empty__text">Same shower. Better water. It starts here.</p>
          <a class="pc-empty__btn" href="{% if plush %}{{ plush.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Shop Plush</a>
          {%- comment -%} Éléments attendus par cart.js, même panier vide {%- endcomment -%}
          <div id="CartDrawer-CartItems" class="visually-hidden"></div>
          <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
          <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status"></p>
          <div id="CartDrawer-CartErrors" class="visually-hidden" role="alert"></div>
        </div>
      {%- else -%}
        <div class="pc-scroll">
          <div class="pc-top">
            <span class="pc-top__word" aria-hidden="true">plush</span>
            <div class="pc-head">
              <p class="pc-title">{{ pc_bag }}Your cart <span class="pc-count">{{ cart.item_count }}</span></p>
              <button class="pc-close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="Close">{{ pc_x }}</button>
            </div>

            {%- if sale_live -%}
              <div class="pc-sale" data-pc-end="{{ sale_end_at }}">
                <p class="pc-sale__label">{{ pc_leaf }}{{ sale_label | escape }}</p>
                <div class="pc-clock">
                  <span><b data-d>--</b><small>DAYS</small></span>
                  <span><b data-h>--</b><small>HRS</small></span>
                  <span><b data-m>--</b><small>MIN</small></span>
                  <span><b data-s>--</b><small>SEC</small></span>
                </div>
              </div>
            {%- endif -%}

            <div class="pc-kit{% if kit_done %} is-done{% endif %}">
              <div class="pc-kit__head">
                {%- if kit_done -%}
                  <span>Your Plush kit is <b>complete</b></span><span class="pc-kit__ok">{{ pc_check }}</span>
                {%- else -%}
                  <span>Your Plush kit · <b>2 of 3</b></span>
                  {%- if show_swap -%}
                    <button type="button" class="pc-kit__link" data-pc-swap data-solo="{{ solo_variant_id }}" data-duo="{{ duo_variant_id }}" data-qty="{{ solo_qty }}" data-duo-qty="{{ duo_qty }}">Complete it · {{ swap_diff | money_without_trailing_zeros }}</button>
                  {%- endif -%}
                {%- endif -%}
              </div>
              <div class="pc-track">
                <div class="pc-fill" style="width:{% if kit_done %}100{% else %}50{% endif %}%"></div>
                <span class="pc-dot is-on" style="left:0%">{{ pc_truck }}</span>
                <span class="pc-dot is-on" style="left:50%">{{ pc_book }}</span>
                <span class="pc-dot{% if kit_done %} is-on{% endif %}" style="left:100%">{{ pc_cart }}</span>
              </div>
              <div class="pc-labels">
                <span class="is-on">Free shipping</span><span class="is-on">Free ebook</span><span{% if kit_done %} class="is-on"{% endif %}>Spare cartridge</span>
              </div>
            </div>
          </div>

          <div class="pc-body">
            {%- if banner_image != blank -%}
              {%- if banner_link != blank -%}<a href="{{ banner_link }}" class="pc-banner">{%- else -%}<div class="pc-banner">{%- endif -%}
              <img src="{{ banner_image }}{% if banner_image contains '?' %}&{% else %}?{% endif %}width=900" alt="" width="1200" height="500" loading="lazy">
              {%- if banner_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
            {%- endif -%}

            <cart-drawer-items>
              <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
                <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
                  <div class="pc-items">
                    {%- for item in cart.items -%}
                      {%- assign idx = forloop.index -%}
                      <div id="CartDrawer-Item-{{ idx }}" class="cart-item pc-item">
                        <a href="{{ item.url }}" class="pc-thumb" tabindex="-1" aria-hidden="true">
                          {%- if item.image -%}
                            <img src="{{ item.image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">
                          {%- endif -%}
                        </a>
                        <div class="pc-item__mid">
                          <a href="{{ item.url }}" class="pc-item__name cart-item__name">{{ item.product.title | escape }}</a>
                          {%- unless item.product.has_only_default_variant -%}
                            <span class="pc-item__var">{{ item.variant.title | escape }}</span>
                          {%- endunless -%}
                          {%- if item.selling_plan_allocation -%}
                            <span class="pc-item__var">{{ item.selling_plan_allocation.selling_plan.name | escape }}</span>
                          {%- endif -%}
                          {%- for discount in item.line_level_discount_allocations -%}
                            <span class="pc-item__disc">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</span>
                          {%- endfor -%}
                          <quantity-input class="pc-qty">
                            <button class="quantity__button" name="minus" type="button" aria-label="Decrease quantity for {{ item.product.title | escape }}">{{ pc_minus }}</button>
                            <input class="quantity__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" data-quantity-variant-id="{{ item.variant.id }}" data-index="{{ idx }}" id="Drawer-quantity-{{ idx }}" aria-label="Quantity for {{ item.product.title | escape }}">
                            <button class="quantity__button" name="plus" type="button" aria-label="Increase quantity for {{ item.product.title | escape }}">{{ pc_plus }}</button>
                          </quantity-input>
                          <div id="CartDrawer-LineItemError-{{ idx }}" class="cart-item__error" role="alert">
                            <small class="cart-item__error-text"></small>
                          </div>
                        </div>
                        <div class="pc-item__right">
                          {%- if item.original_line_price != item.final_line_price -%}
                            <s class="pc-item__was">{{ item.original_line_price | money }}</s>
                          {%- endif -%}
                          <b class="pc-item__price">{{ item.final_line_price | money }}</b>
                          <cart-remove-button id="CartDrawer-Remove-{{ idx }}" data-index="{{ idx }}">
                            <button type="button" class="pc-remove" aria-label="Remove {{ item.product.title | escape }}">{{ pc_trash }}</button>
                          </cart-remove-button>
                          <span class="pc-spin loading__spinner hidden" aria-hidden="true"></span>
                        </div>
                      </div>
                    {%- endfor -%}

                    <div class="pc-item pc-gift">
                      <span class="pc-thumb pc-thumb--gift">
                        {%- if gift_image != blank -%}<img src="{{ gift_image }}" alt="" width="120" height="120" loading="lazy">{%- else -%}{{ pc_book }}{%- endif -%}
                      </span>
                      <div class="pc-item__mid">
                        <span class="pc-item__name">{{ gift_title | escape }}</span>
                        <span class="pc-item__var">{{ gift_subtitle | escape }}</span>
                        <span class="pc-chip">{{ pc_gift }}Free gift</span>
                      </div>
                      <div class="pc-item__right">
                        <b class="pc-free">FREE</b>
                        {%- if gift_value != blank -%}<s class="pc-item__was">{{ gift_value }}</s>{%- endif -%}
                      </div>
                    </div>
                  </div>
                  <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
                  <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">Loading…</p>
                </div>
                <div id="CartDrawer-CartErrors" class="pc-errors" role="alert"></div>
              </form>
            </cart-drawer-items>

            {%- if show_swap or show_extra or show_protection -%}
              <p class="pc-label">{% if show_swap %}Complete your kit{% else %}Add-ons{% endif %}</p>
            {%- endif -%}

            {%- if show_swap -%}
              <div class="pc-card pc-up">
                <span class="pc-up__icon">{{ pc_cart }}</span>
                <div>
                  <b>Spare cartridge</b>
                  <span>Switch to the Duo. Your next one, already home.</span>
                  {%- if cartridge and cartridge.price > swap_diff -%}
                    <span class="pc-up__save">Instead of {{ cartridge.price | money_without_trailing_zeros }} on its own</span>
                  {%- endif -%}
                </div>
                <button type="button" class="pc-up__btn" data-pc-swap data-solo="{{ solo_variant_id }}" data-duo="{{ duo_variant_id }}" data-qty="{{ solo_qty }}" data-duo-qty="{{ duo_qty }}">+ {{ swap_diff | money_without_trailing_zeros }}</button>
              </div>
            {%- endif -%}

            {%- if show_extra -%}
              <div class="pc-card pc-up">
                <span class="pc-up__icon">{{ pc_cart }}</span>
                <div><b>Extra cartridge</b><span>For the next swap, already home.</span></div>
                <button type="button" class="pc-up__btn" data-pc-add="{{ cartridge.selected_or_first_available_variant.id }}">+ {{ cartridge.price | money_without_trailing_zeros }}</button>
              </div>
            {%- endif -%}

            {%- if show_protection -%}
              <div class="pc-card pc-up">
                <span class="pc-up__icon">{{ pc_shield }}</span>
                <div><b>Shipping protection</b><span>Lost or damaged? We resend it.</span></div>
                <button type="button" class="pc-up__btn pc-up__btn--soft" data-pc-add="{{ protection.selected_or_first_available_variant.id }}">+ {{ protection.price | money }}</button>
              </div>
            {%- endif -%}

            <div class="pc-eta">
              {{ pc_cal }}
              <div><span>Estimated delivery</span><b data-pc-eta data-min="{{ ship_min_days }}" data-max="{{ ship_max_days }}">{{ ship_min_days }}–{{ ship_max_days }} business days</b><span class="pc-eta__note">· free &amp; tracked</span></div>
            </div>

            <form class="pc-code" data-pc-discount data-codes="{{ applied_codes | escape }}">
              <input type="text" name="discount" placeholder="Discount code" autocomplete="off" aria-label="Discount code">
              <button type="submit">Apply</button>
            </form>
            <p class="pc-code__msg" data-pc-code-msg hidden></p>
            {%- if applied_codes != blank -%}
              <div class="pc-codes">
                {%- assign code_list = applied_codes | split: ',' -%}
                {%- for c in code_list -%}
                  {%- assign others = '' -%}
                  {%- for o in code_list -%}{%- if o != c -%}{%- assign others = others | append: o | append: ',' -%}{%- endif -%}{%- endfor -%}
                  <span class="pc-codes__chip" data-pc-code="{{ c | downcase | escape }}">{{ c | escape }}<button type="button" data-pc-rmcode data-keep="{{ others | escape }}" aria-label="Remove {{ c | escape }}">{{ pc_x }}</button></span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="drawer__footer cart-drawer__footer pc-foot">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="pc-row pc-row--disc"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="pc-row pc-row--total"><span>Subtotal</span><b>{{ cart.total_price | money }}</b></div>
          <div class="pc-row pc-row--ship"><span>Shipping</span><span>{{ shipping_label | escape }}</span></div>
          <button type="submit" id="CartDrawer-Checkout" class="cart__checkout-button pc-checkout" name="checkout" form="CartDrawer-Form">{{ pc_lock }}Checkout · {{ cart.total_price | money }}</button>
          <ul class="pc-pay" role="list">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pc-pay__icon' }}</li>{%- endfor -%}
          </ul>
          <p class="pc-guarantee">{{ guarantee | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

<script>
  (function () {
    if (window.PlushCart) return;
    window.PlushCart = true;
    var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';

    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function addBusinessDays(n) {
      var d = new Date();
      while (n > 0) { d.setDate(d.getDate() + 1); var w = d.getDay(); if (w !== 0 && w !== 6) n--; }
      return d;
    }
    function shortDate(d) { return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }

    function tick() {
      document.querySelectorAll('[data-pc-end]').forEach(function (el) {
        var left = new Date(el.getAttribute('data-pc-end')).getTime() - Date.now();
        if (!(left > 0)) { el.hidden = true; return; }
        var s = Math.floor(left / 1000);
        el.querySelector('[data-d]').textContent = Math.floor(s / 86400);
        el.querySelector('[data-h]').textContent = pad(Math.floor((s % 86400) / 3600));
        el.querySelector('[data-m]').textContent = pad(Math.floor((s % 3600) / 60));
        el.querySelector('[data-s]').textContent = pad(s % 60);
      });
      document.querySelectorAll('[data-pc-eta]:not([data-done])').forEach(function (el) {
        el.textContent = shortDate(addBusinessDays(+el.dataset.min)) + ' – ' + shortDate(addBusinessDays(+el.dataset.max));
        el.setAttribute('data-done', '');
      });
    }
    tick();
    setInterval(tick, 1000);

    function post(path, body) {
      body.sections = 'cart-drawer,cart-icon-bubble';
      body.sections_url = window.location.pathname;
      return fetch(root + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body)
      }).then(function (r) { return r.json(); }).then(function (state) {
        if (state.status && state.description) throw new Error(state.description);
        return state;
      });
    }
    function render(state) {
      var drawer = document.querySelector('cart-drawer');
      if (drawer && state.sections && state.sections['cart-drawer']) {
        drawer.classList.remove('is-empty');
        drawer.renderContents(state);
        tick();
      } else {
        window.location.reload();
      }
    }
    function fail(btn) {
      if (btn) { btn.disabled = false; btn.classList.remove('is-loading'); }
      var box = document.getElementById('CartDrawer-CartErrors');
      if (box) box.textContent = 'Something went wrong. Please try again.';
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-pc-swap],[data-pc-add],[data-pc-rmcode]');
      if (!btn || btn.disabled) return;
      e.preventDefault();
      btn.disabled = true;
      btn.classList.add('is-loading');
      var job;
      if (btn.hasAttribute('data-pc-swap')) {
        var updates = {};
        updates[btn.dataset.solo] = 0;
        updates[btn.dataset.duo] = (parseInt(btn.dataset.duoQty, 10) || 0) + (parseInt(btn.dataset.qty, 10) || 1);
        job = post('cart/update.js', { updates: updates });
      } else if (btn.hasAttribute('data-pc-add')) {
        job = post('cart/add.js', { items: [{ id: parseInt(btn.dataset.pcAdd, 10), quantity: 1 }] });
      } else {
        job = post('cart/update.js', { discount: (btn.dataset.keep || '').replace(/,$/, '') });
      }
      job.then(render).catch(function () { fail(btn); });
    });

    document.addEventListener('submit', function (e) {
      var form = e.target.closest('[data-pc-discount]');
      if (!form) return;
      e.preventDefault();
      var input = form.querySelector('input');
      var code = input.value.trim();
      if (!code) return;
      var codes = (form.dataset.codes || '').split(',').filter(Boolean);
      if (codes.map(function (c) { return c.toLowerCase(); }).indexOf(code.toLowerCase()) === -1) codes.push(code);
      var btn = form.querySelector('button');
      btn.disabled = true;
      post('cart/update.js', { discount: codes.join(',') }).then(function (state) {
        render(state);
        var ok = document.querySelector('[data-pc-code="' + code.toLowerCase().replace(/"/g, '') + '"]');
        var bad = (state.discount_codes || []).some(function (d) { return d.code.toLowerCase() === code.toLowerCase() && d.applicable === false; });
        if (!ok || bad) {
          var msg = document.querySelector('[data-pc-code-msg]');
          if (msg) { msg.textContent = 'This code doesn\'t apply to your cart.'; msg.hidden = false; }
        }
      }).catch(function () { btn.disabled = false; fail(); });
    });
  })();
</script>

<style>
