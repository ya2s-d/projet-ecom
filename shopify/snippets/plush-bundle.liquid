  #{{ uid }} .pb-gbadge s{opacity:.75;font-weight:600;margin-left:2px}
  #{{ uid }} .pb-gic{width:46%;height:46%;fill:none;stroke:var(--pb-accent);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  {%- comment -%} Les 3 textes ont la même hauteur (2 lignes réservées) et partent du même point : ils restent alignés même si un nom est plus court {%- endcomment -%}
  #{{ uid }} .pb-glabel{display:block;margin-top:8px;min-height:2.6em;font-size:13px;font-size:clamp(10px,3.15cqi,13px);font-weight:600;line-height:1.3;text-wrap:balance;overflow-wrap:break-word}
  @media (max-width:380px){
    #{{ uid }} .pb-gifts{gap:7px}
  }
</style>

<script>
  (function () {
    var root = document.getElementById('{{ uid }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    var cards = root.querySelectorAll('.pb-opt');
    var ids = [];
    cards.forEach(function (c) { ids.push(c.dataset.variant); });
    {%- comment -%} Tous les ID de variantes du produit, pour ne viser que ses formulaires {%- endcomment -%}
    var productIds = [{% for v in product.variants %}'{{ v.id }}'{% unless forloop.last %},{% endunless %}{% endfor %}];

    var section = root.closest('.shopify-section');
    var optNames = {{ product.options | json }};
    var productUrl = {{ product.url | json }};

    // Sélectionne la même variante dans le sélecteur du thème (variant-radios / variant-selects),
    // pour que le thème mette lui-même à jour le prix, l'URL et le formulaire d'achat.
    function syncPicker(values) {
      var pickers = (section || document).querySelectorAll('variant-radios, variant-selects');
      var picker = null;
      pickers.forEach(function (p) { if (!picker && p.dataset.url === productUrl) picker = p; });
      if (!picker) return false;
      var last = null;
      values.forEach(function (val, i) {
        var name = optNames[i];
        picker.querySelectorAll('input[type="radio"]').forEach(function (r) {
          if (r.name === name && r.value === val && !r.checked) { r.checked = true; last = r; }
        });
        picker.querySelectorAll('select').forEach(function (s) {
          if (s.name === 'options[' + name + ']' && s.value !== val) { s.value = val; last = s; }
        });
      });
      if (last) last.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    }

    function targets() {
      var out = [];
      document.querySelectorAll('form[action*="/cart/add"] [name="id"]').forEach(function (el) {
        var mine = productIds.indexOf(String(el.value)) !== -1;
        var sameSection = section && el.closest('.shopify-section') === section;
        if (mine || sameSection) out.push(el);
      });
      return out;
    }

    function apply(card) {
      if (!card || card.classList.contains('is-out')) return;
      cards.forEach(function (c) {
        var on = c === card;
        c.classList.toggle('is-on', on);
        c.querySelector('input').checked = on;
      });
      var id = card.dataset.variant;
      try { syncPicker(JSON.parse(card.dataset.options || '[]')); } catch (e) {}
      targets().forEach(function (el) {
        if (el.tagName === 'SELECT' && !el.querySelector('option[value="' + id + '"]')) return;
        el.value = id;
        el.dispatchEvent(new Event('change', { bubbles: true }));
      });
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', id);
        window.history.replaceState({}, '', url.toString());
      } catch (e) {}
    }

    cards.forEach(function (c) {
      c.addEventListener('click', function (e) {
        if (e.target.tagName === 'INPUT') return; // clavier : laisser le radio changer seul
        e.preventDefault();
        apply(c);
      });
      c.querySelector('input').addEventListener('change', function () { apply(c); });
    });

    // Le formulaire « Ajouter au panier » est plus bas dans la page :
    // on attend qu'il existe avant de forcer la variante par défaut.
    function init() {
      var fromUrl = null;
      try { fromUrl = new URL(window.location.href).searchParams.get('variant'); } catch (e) {}
      var start = (fromUrl && ids.indexOf(fromUrl) !== -1)
        ? root.querySelector('.pb-opt[data-variant="' + fromUrl + '"]')
        : root.querySelector('.pb-opt[data-i="' + root.dataset.selected + '"]');
      apply(start || cards[0]);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
