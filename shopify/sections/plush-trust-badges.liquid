{%- comment -%}
  Plush — bandeau de badges de confiance.
  À installer dans Modifier le code > sections > « plush-trust-badges.liquid ».
  Ensuite : Personnaliser > Ajouter une section > « Plush – Badges confiance ».
  Chaque badge est un bloc : icône intégrée OU ton propre logo, + texte.
{%- endcomment -%}

{%- liquid
  assign sid = 'pt-' | append: section.id
  assign c_icon = section.settings.icon_color | default: '#8A4524'
  assign c_text = section.settings.text_color | default: '#141414'
  assign c_card = section.settings.card_color | default: '#F6F2ED'
  assign c_tint = c_icon | color_modify: 'alpha', 0.12
  assign n = section.blocks.size | at_least: 1
-%}

<div
  id="{{ sid }}"
  class="pt pt--{{ section.settings.mobile_layout }}{% if section.settings.show_card %} pt--card{% endif %}"
  style="--pt-icon:{{ c_icon }};--pt-tint:{{ c_tint }};--pt-text:{{ c_text }};--pt-card:{{ c_card }};--pt-n:{{ n }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="pt-h">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="pt-box">
      <ul class="pt-grid" role="list">
        {%- for block in section.blocks -%}
          <li class="pt-item" {{ block.shopify_attributes }}>
            <span class="pt-ic{% if block.settings.image != blank %} pt-ic--img{% endif %}">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 160 }}"
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'install' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h7a4 4 0 0 1 4 4"/><path d="M8 13a6 6 0 0 1 12 0z"/><path d="M10 16v1.5M14 16v2.5M18 16v1.5"/></svg>
                  {%- when 'trial' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><text x="12" y="18" text-anchor="middle" font-size="7" font-weight="700" fill="currentColor" stroke="none" font-family="inherit">60</text></svg>
                  {%- when 'parcel' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8.5 4.3v9.4L12 21l-8.5-4.3V7.3z"/><path d="M3.5 7.3L12 11.6l8.5-4.3M12 11.6V21M7.8 5.1l8.5 4.4"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h11.5v10H2.5zM14 10h4.2l3.3 3.4v3.1H14"/><circle cx="6.5" cy="17.5" r="1.9"/><circle cx="17.5" cy="17.5" r="1.9"/></svg>
                  {%- when 'secure' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/><path d="M12 14.5v2.5"/></svg>
                  {%- when 'filter' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="3"/><path d="M7 8h10M7 16h10"/></svg>
                  {%- when 'refund' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v10.5H10l-5 4v-4H4z"/><path d="M8 10h8M8 13h5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            <span class="pt-txt">
              {%- comment -%} Chaque mot reste entier : « Tool-Free » ne se coupe jamais au tiret {%- endcomment -%}
              <span class="pt-t">
                {%- assign words = block.settings.title | split: ' ' -%}
                {%- for w in words -%}{%- unless forloop.first -%}{{ ' ' }}{%- endunless -%}<span class="pt-w">{{ w | escape }}</span>{%- endfor -%}
              </span>
              {%- if block.settings.subtitle != blank -%}
                <span class="pt-s">{{ block.settings.subtitle | escape }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

<style>
  #{{ sid }} .pt-box{max-width:1100px;margin:0 auto}
  #{{ sid }}.pt--card .pt-box{background:var(--pt-card);border-radius:16px;padding:18px 14px}
  #{{ sid }} .pt-h{margin:0 0 14px;text-align:center;color:var(--pt-text)}
  #{{ sid }} .pt-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 10px}
  #{{ sid }} .pt-item{display:flex;align-items:center;gap:10px;min-width:0;color:var(--pt-text)}
  #{{ sid }} .pt-ic{flex:0 0 42px;width:42px;height:42px;border-radius:50%;background:var(--pt-tint);color:var(--pt-icon);display:flex;align-items:center;justify-content:center}
  #{{ sid }} .pt-ic svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
  #{{ sid }} .pt-ic--img{background:none}
  #{{ sid }} .pt-ic img{width:100%;height:100%;object-fit:contain;display:block}
  #{{ sid }} .pt-txt{display:flex;flex-direction:column;min-width:0}
  #{{ sid }} .pt-t{font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;line-height:1.25;text-wrap:balance}
  #{{ sid }} .pt-w{white-space:nowrap}
  #{{ sid }} .pt-s{margin-top:3px;font-size:12px;line-height:1.3;opacity:.7}

  {%- comment -%} Option « 4 sur une ligne » sur mobile {%- endcomment -%}
  #{{ sid }}.pt--row .pt-grid{grid-template-columns:repeat(var(--pt-n),minmax(0,1fr));gap:8px}
  #{{ sid }}.pt--row .pt-item{flex-direction:column;text-align:center;gap:8px}
  #{{ sid }}.pt--row .pt-t{font-size:10.5px;letter-spacing:.03em}
  #{{ sid }}.pt--row .pt-s{display:none}

  {%- comment -%} Ordinateur : les badges sur une ligne, icône au-dessus du texte {%- endcomment -%}
  @media screen and (min-width:750px){
    #{{ sid }}.pt--card .pt-box{padding:28px 24px}
    #{{ sid }} .pt-grid,
    #{{ sid }}.pt--row .pt-grid{grid-template-columns:repeat(var(--pt-n),minmax(0,1fr));gap:20px}
    #{{ sid }} .pt-item,
    #{{ sid }}.pt--row .pt-item{flex-direction:column;text-align:center;gap:12px}
    #{{ sid }} .pt-ic{flex-basis:60px;width:60px;height:60px}
    #{{ sid }} .pt-ic svg{width:30px;height:30px;stroke-width:1.5}
    #{{ sid }} .pt-t,
    #{{ sid }}.pt--row .pt-t{font-size:14px;letter-spacing:.05em}
    #{{ sid }}.pt--row .pt-s{display:block}
    #{{ sid }} .pt-s{font-size:13px}
  }
</style>

{% schema %}
{
  "name": "Plush – Badges confiance",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre au-dessus (optionnel)"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Sur mobile",
      "options": [
        { "value": "grid", "label": "2 × 2, icône à gauche (recommandé)" },
        { "value": "row", "label": "4 sur une ligne, icône au-dessus" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_card",
      "label": "Fond arrondi derrière les badges",
      "default": true
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Couleur du fond arrondi",
      "default": "#F6F2ED"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Couleur des icônes",
      "default": "#8A4524"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#141414"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace au-dessus",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en dessous",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "install", "label": "Pommeau (installation)" },
            { "value": "trial", "label": "Calendrier 60 jours" },
            { "value": "parcel", "label": "Colis" },
            { "value": "truck", "label": "Camion" },
            { "value": "secure", "label": "Cadenas (paiement sécurisé)" },
            { "value": "filter", "label": "Cartouche" },
            { "value": "refund", "label": "Flèche (remboursement)" },
            { "value": "support", "label": "Bulle (service client)" },
            { "value": "check", "label": "Coche" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ou ton propre logo",
          "info": "Remplace l'icône. PNG à fond transparent, carré."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Texte",
          "default": "Badge"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Petite ligne en dessous (optionnel)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Plush – Badges confiance",
      "blocks": [
        { "type": "badge", "settings": { "icon": "install", "title": "Tool-Free Install", "subtitle": "No plumber needed" } },
        { "type": "badge", "settings": { "icon": "trial", "title": "60-Day Trial", "subtitle": "Love it or get a refund" } },
        { "type": "badge", "settings": { "icon": "parcel", "title": "Free U.S. Shipping", "subtitle": "Tracked, 7–12 business days" } },
        { "type": "badge", "settings": { "icon": "secure", "title": "Secure Checkout", "subtitle": "Encrypted payment" } }
      ]
    }
  ]
}
{% endschema %}
